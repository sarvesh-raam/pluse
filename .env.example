# --- App ---
APP_NAME=Pulse
# ENV=production refuses to boot with the default JWT_SECRET and hides /docs
ENV=development
LOG_LEVEL=INFO

# --- Postgres (used by the postgres service itself) ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
POSTGRES_PORT=5432

# --- Backend (api / scheduler / worker) ---
# Host-relative URL for the api/scheduler/worker containers (talks to the "postgres" service by name)
DATABASE_URL=postgresql+asyncpg://pulse:pulse@postgres:5432/pulse

# generate a real one with: openssl rand -hex 32
JWT_SECRET=dev-only-please-change-this-secret-before-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]

HEARTBEAT_SEC=5
VISIBILITY_TIMEOUT_SEC=30
SCHED_TICK_SEC=1
REAPER_TICK_SEC=5
# telemetry retention (pruned by the reaper about once a minute)
HEARTBEAT_RETENTION_HOURS=6
DEAD_WORKER_RETENTION_HOURS=24

# --- Worker ---
# WORKER_QUEUES empty = subscribe to every queue in WORKER_PROJECT_SLUG's project.
# Scale with `docker compose up --scale worker=3` to see distributed claiming.
WORKER_PROJECT_SLUG=demo
WORKER_QUEUES=
WORKER_CONCURRENCY=5
WORKER_SHUTDOWN_GRACE_SEC=30
# Prometheus /metrics ports for the worker and scheduler (the API serves
# /metrics on its own port). 0 disables.
WORKER_METRICS_PORT=9100
SCHEDULER_METRICS_PORT=9101

# --- Chaos engineering ---
# auto = delete the worker pod via the Kubernetes API when in-cluster,
#        otherwise make the worker crash itself (exit 137) for docker/supervisord
#        to restart. Set CHAOS_ENABLED=false to disable the kill button entirely.
CHAOS_ENABLED=true
CHAOS_MODE=auto

API_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Bonus: AI failure summaries (optional) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
